{
  "name": "pi-ds4",
  "version": "0.2.0",
  "description": "Pi provider extension for local ds4.c DeepSeek V4, DeepSeek V4.1, GLM 5.2/5.3 and Qwen3.8 inference.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ds4",
    "deepseek",
    "glm",
    "qwen"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./pi-ds4-config"
    ]
  },
  "files": [
    "index.ts",
    "catalog.ts",
    "locks.ts",
    "progress.ts",
    "ds4-watchdog.sh",
    "install-pi-extension-local.sh",
    "settings.example.json",
    "settings.schema.json",
    "pi-ds4-config/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaanozdokmeci/pi-ds4.git"
  }
}
